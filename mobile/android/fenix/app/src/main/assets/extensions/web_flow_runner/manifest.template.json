{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "web-flow-runner@mozilla.org"
    }
  },
  "name": "Firefox - Web Flow Runner",
  "version": "${version}",
  "content_scripts": [
    {
      "matches": [
        "https://takeout.google.com/*",
        "https://passwords.google.com/*",
        "https://accounts.google.com/*"
      ],
      "js": ["web-flow-content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["web-flow-background.js"],
    "persistent": true
  },
  "permissions": [
    "mozillaAddons",
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "tabs",
    "https://takeout.google.com/*",
    "https://passwords.google.com/*",
    "https://accounts.google.com/*"
  ]
}

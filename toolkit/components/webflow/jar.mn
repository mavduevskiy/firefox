# The controller and runner are shared with Android's extension; the
# extension's Android glue is packaged only so the xpcshell tests can load it.
toolkit.jar:
% resource webflow %content/global/webflow/
  content/global/webflow/extension/web-flow-background.js              (extension/web-flow-background.js)
  content/global/webflow/extension/web-flow-controller.js              (extension/web-flow-controller.js)
  content/global/webflow/extension/web-flow-runner.js                  (extension/web-flow-runner.js)

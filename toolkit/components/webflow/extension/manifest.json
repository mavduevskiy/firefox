{
  "manifest_version": 2,
  "name": "Web Flow Runner",
  "description": "Drives multi-page web flows, such as data exports, in a hidden tab on behalf of Firefox for Android.",
  "version": "158.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "web-flow-runner@mozilla.org"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://takeout.google.com/*",
        "https://passwords.google.com/*",
        "https://accounts.google.com/*"
      ],
      "js": ["web-flow-runner.js", "web-flow-content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "scripts": ["web-flow-controller.js", "web-flow-background.js"],
    "persistent": true
  },
  "permissions": [
    "mozillaAddons",
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "tabs",
    "https://takeout.google.com/*",
    "https://passwords.google.com/*",
    "https://accounts.google.com/*"
  ]
}
